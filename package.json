{
  "name": "ojtec",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prebuild": "npm run content:check",
    "content:build": "node scripts/build-content.js",
    "content:check": "node scripts/validate-content.js",
    "content:check:strict": "node scripts/validate-content.js --strict",
    "test": "node --test \"shared/**/*.test.js\" \"scripts/**/*.test.js\" \"server/**/*.test.js\" \"src/**/*.test.js\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/dev.js",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "start": "node server/index.js",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.1.17",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "gsap": "^3.13.0",
    "helmet": "^8.3.0",
    "react": "^19.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.0",
    "react-responsive": "^10.0.1",
    "tailwindcss": "^4.1.17",
    "three": "^0.181.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.64.1",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22.9"
  }
}
