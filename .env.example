# Copy to .env and fill in locally. Production values go in hPanel env vars.
# Never put real values in this file. Anything prefixed VITE_ is shipped to the browser.

# --- Server ---
PORT=
NODE_ENV=

# GitHub (fine-grained token, read-only public repos)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Claude API (Ask My Portfolio)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CHAT_DAILY_BUDGET_USD=

# Contact form (Hostinger SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# Cloudflare Turnstile
TURNSTILE_SECRET=

# Buea (weather + time)
BUEA_LAT=
BUEA_LON=
BUEA_TZ=

# --- Client (public by design) ---
VITE_TURNSTILE_SITE_KEY=

# --- Legacy: EmailJS, used by src/sections/Contact.jsx until P5-03 removes it ---
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=
