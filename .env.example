# Copy to .env and fill in locally. Production values go in hPanel env vars.
# Never put real values in this file. Anything prefixed VITE_ is shipped to the browser.

# --- Server ---
PORT=
NODE_ENV=
# 1 only after SSL is confirmed (P0-05)
ENABLE_HSTS=

# GitHub (fine-grained token, read-only public repos). Optional: without it /api/city uses the 60 req/h anonymous limit.
# GITHUB_USERNAME is optional and currently unused.
GITHUB_TOKEN=
GITHUB_USERNAME=

# Ask My Portfolio, optional AI layer (ADR-014): Groq free tier. Never add a payment method to the Groq account.
# Without GROQ_API_KEY the built-in guide answers everything.
GROQ_API_KEY=
GROQ_MODEL=
# AI answers per day before the built-in guide takes over (keep below Groq's free daily limit)
CHAT_DAILY_AI_LIMIT=

# Contact form (Hostinger SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# Cloudflare Turnstile
TURNSTILE_SECRET=

# Buea (weather + time)
BUEA_LAT=
BUEA_LON=
BUEA_TZ=

# Content build: set to 1 at launch so [DEMO] / TODO(content) fail the build (ADR-010)
CONTENT_STRICT=

# --- Client (public by design) ---
VITE_TURNSTILE_SITE_KEY=

# --- Legacy: EmailJS, used by src/sections/Contact.jsx until P5-03 removes it ---
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=
